{
  "name": "kedgely",
  "version": "0.9.0",
  "private": true,
  "description": "Kedgely — adaptive AI day planner that re-plans your day when work slips.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "node scripts/build.js",
    "start:prod": "node --disable-warning=ExperimentalWarning scripts/start-prod.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "admin:create": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.3.0",
    "nodemailer": "^6.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3"
  }
}
